# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# The anon key is meant to be public; row level security in supabase/guestbook.sql
# is what keeps visitors to reading approved doodles and submitting new ones.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
